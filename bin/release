#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
case "${1:-}" in
  --help|-h) printf 'Usage: bin/release [--dry-run]\nCreate the committed VERSION tag locally; push it to trigger tested GitHub binaries.\n'; exit 0 ;;
  ''|--dry-run) ;;
  *) printf 'Usage: bin/release [--dry-run]\n' >&2; exit 2 ;;
esac
[[ $# -le 1 ]] || exit 2
version="$(cat VERSION)"
[[ "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || { printf 'error: invalid VERSION\n' >&2; exit 1; }
tag="v${version}"
[[ -z "$(git status --porcelain)" ]] || { printf 'error: commit changes before bin/release\n' >&2; exit 1; }
if git rev-parse --verify --quiet "refs/tags/${tag}" >/dev/null; then
  printf 'error: tag already exists locally: %s\n' "$tag" >&2
  exit 1
fi
# A failed remote lookup must not be mistaken for an available version.
remote_tags="$(git ls-remote --quiet --tags origin "refs/tags/${tag}")"
[[ -z "$remote_tags" ]] || { printf 'error: tag already exists on origin: %s\n' "$tag" >&2; exit 1; }
if [[ "${1:-}" == --dry-run ]]; then
  printf 'would create tag %s\n' "$tag"
  exit 0
fi
git tag "$tag"
printf 'created tag %s\nPush with: git push origin %s\n' "$tag" "$tag"
