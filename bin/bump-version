#!/usr/bin/env bash
set -euo pipefail
if [[ $# -ne 1 || ! "$1" =~ ^(major|minor|patch)$ ]]; then
  printf 'usage: %s <major|minor|patch>\n' "${0##*/}" >&2
  exit 2
fi
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
python3 - "$1" "${repo_root}/VERSION" <<'PY'
from pathlib import Path
import re
import sys
path = Path(sys.argv[2])
old = path.read_text().strip()
if not re.fullmatch(r'(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)', old):
    raise SystemExit('error: VERSION must contain a stable semantic version')
parts = list(map(int, old.split('.')))
index = {'major': 0, 'minor': 1, 'patch': 2}[sys.argv[1]]
parts[index] += 1
for following in range(index + 1, 3):
    parts[following] = 0
new = '.'.join(map(str, parts))
path.write_text(new + '\n')
print(f'bumped version {old} -> {new}; commit VERSION before bin/release')
PY
