#!/usr/bin/env bash
set -euo pipefail
if [[ $# -ne 1 ]]; then
  printf 'Usage: bin/build-release OUTPUT_DIRECTORY\n' >&2
  exit 2
fi
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
mkdir -p "$1"
output_dir="$(cd -- "$1" && pwd)"
[[ -z "$(ls -A "$output_dir")" ]] || { printf 'error: output directory must be empty\n' >&2; exit 1; }
cd "$repo_root"
version="$(cat VERSION)"
[[ "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] || { printf 'error: invalid VERSION\n' >&2; exit 1; }
build_dir="$(mktemp -d)"
trap 'rm -rf "$build_dir"' EXIT
go mod download
websocket_dir="$(go list -m -f '{{.Dir}}' github.com/coder/websocket)"
for target in linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64 windows/arm64; do
  target_os="${target%/*}"
  target_arch="${target#*/}"
  package="morsecode-audio_${version}_${target_os}_${target_arch}"
  stage="${build_dir}/${package}"
  mkdir -p "$stage/licenses"
  binary=morsecode-audio
  [[ "$target_os" != windows ]] || binary=morsecode-audio.exe
  CGO_ENABLED=0 GOOS="$target_os" GOARCH="$target_arch" \
    go build -trimpath -ldflags="-s -w -X main.version=${version}" \
    -o "$stage/$binary" ./cmd/morsecode-audio
  cp README.md "$stage/"
  cp -R docs "$stage/"
  cp internal/api/assets/INTER-LICENSE.txt "$stage/licenses/"
  cp "$websocket_dir/LICENSE.txt" "$stage/licenses/WEBSOCKET-LICENSE.txt"
  if [[ "$target_os" == windows ]]; then
    (cd "$stage" && python3 -m zipfile -c "${output_dir}/${package}.zip" "$binary" README.md docs licenses)
  else
    tar -C "$stage" -czf "${output_dir}/${package}.tar.gz" .
  fi
  printf 'built %s\n' "$package"
done
(cd "$output_dir" && sha256sum *.tar.gz *.zip > checksums.txt)
